---
import type { Locale, SiteDictionary } from "@/i18n/schema";

interface Props {
  locale: Locale;
  dictionary: SiteDictionary;
}

// Props are accepted (and passed by all page components) but the current
// footer copy is hardcoded. Wire them up if/when the footer becomes
// dictionary-driven.
const { locale: _locale, dictionary: _dictionary } = Astro.props;
---

<footer class="site-footer">
  <p>
    © {new Date().getFullYear()} SelecAI (주)로그케이 · <a href="#">이용약관</a> · <a href="#">개인정보처리방침</a> · 문의: <a href="mailto:contact@logk.co.kr">contact@logk.co.kr</a>
  </p>
</footer>
