---
import type { Locale, SiteDictionary } from "@/i18n/schema";

interface Props {
  locale: Locale;
  dictionary: SiteDictionary;
}

const year = new Date().getFullYear();
const contactEmail = "contact@logk.co.kr";
---

<footer id="company" class="site-footer">
  <p>
    © {year} SelecAI (주)로그케이 · <a href="#">이용약관</a> · <a href="#">개인정보처리방침</a> · 문의:
    <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
  </p>
</footer>
