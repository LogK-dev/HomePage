---
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import type { Locale, SiteDictionary } from "@/i18n/schema";
import { localizedPath } from "@/utils/i18n";

type LanguageOption = {
  label: string;
  href: string;
  active: boolean;
};

interface Props {
  locale: Locale;
  dictionary: SiteDictionary;
  languageOptions: LanguageOption[];
}

const { locale, dictionary, languageOptions } = Astro.props;
const homePath = localizedPath(locale);
const currentPath = Astro.url.pathname;

/** Returns true when the nav item's target matches the current page. */
const isActive = (href: string): boolean => {
  if (href.startsWith("#")) return false;
  const target = localizedPath(locale, href);
  return currentPath === target || currentPath.startsWith(target + "/");
};
---

<header class="site-header" data-header>
  <a class="brand" href={homePath} aria-label={`${dictionary.meta.siteName} home`}>
    <span class="brand-mark">L</span>
    <span class="brand-word">{dictionary.meta.siteName}</span>
  </a>

  <button
    class="nav-toggle"
    type="button"
    aria-expanded="false"
    aria-label={dictionary.nav.menuOpen}
    data-nav-toggle
    data-menu-open-label={dictionary.nav.menuOpen}
    data-menu-close-label={dictionary.nav.menuClose}
  >
    <span></span>
    <span></span>
  </button>

  <nav class="site-nav" data-nav>
    {dictionary.nav.items.map((item) => (
      <a
        class:list={[{ "nav-active": isActive(item.href) }]}
        href={item.href.startsWith("#") ? `${homePath}${item.href}` : localizedPath(locale, item.href)}
      >
        {item.label}
      </a>
    ))}
  </nav>

  <div class="header-actions">
    <a class="button header-cta" href="mailto:hello@logk.ai">
      {dictionary.nav.bookDemo}
    </a>
  </div>

  <div class="header-controls">
    <LanguageSwitcher label={dictionary.localeSwitcher.label} options={languageOptions} />
    <ThemeToggle
      label={dictionary.theme.toggleLabel}
      lightLabel={dictionary.theme.light}
      darkLabel={dictionary.theme.dark}
    />
  </div>
</header>
