---
interface Segment {
  label: string;
  src: string;
  type: "image" | "video";
}

interface Props {
  segments: Segment[];
}

const { segments } = Astro.props;
---

<div class="media-shelf" data-media-shelf>
  <!-- Segmented tab bar -->
  <div class="media-tabs-wrap">
    <div class="media-tabs" role="tablist" data-media-tabs>
      {segments.map((seg, i) => (
        <button
          type="button"
          role="tab"
          class:list={["media-tab", { "is-active": i === 0 }]}
          data-media-tab={i}
          aria-selected={i === 0 ? "true" : "false"}
        >
          {seg.label}
        </button>
      ))}
    </div>
  </div>

  <!-- Content shelf — peek both sides via 85% slide width + center snap -->
  <div class="media-shelf-track" data-media-track>
    {segments.map((seg, i) => (
      <div class="media-shelf-slide" data-media-slide={i}>
        {seg.type === "video" ? (
          <video src={seg.src} autoplay muted loop playsinline preload="auto" />
        ) : (
          <img src={seg.src} alt={seg.label} loading={i === 0 ? "eager" : "lazy"} />
        )}
      </div>
    ))}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-media-shelf]").forEach((shelf) => {
    const track = shelf.querySelector<HTMLElement>("[data-media-track]")!;
    const tabs = shelf.querySelectorAll<HTMLButtonElement>("[data-media-tab]");

    /** While a tab click is animating the track to its destination, intermediate
        slides pass through the observer threshold and would briefly steal
        `.is-active`, causing the tab bar to "blink" through every tab between
        source and destination. We lock the destination tab and suppress
        observer-driven sync until the programmatic scroll settles. */
    let programmaticScrollActive = false;
    let scrollSettleTimer: number | null = null;

    function syncTabs(index: number) {
      tabs.forEach((tab, i) => {
        tab.classList.toggle("is-active", i === index);
        tab.setAttribute("aria-selected", i === index ? "true" : "false");
      });
    }

    function goTo(index: number) {
      const slide = track.querySelector<HTMLElement>(`[data-media-slide="${index}"]`);
      if (!slide) return;
      // Lock the destination tab *before* scrolling so intermediate slides
      // can't flip it back.
      syncTabs(index);
      programmaticScrollActive = true;
      slide.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" });

      // Release the lock once scrolling stops. Prefer the native scrollend
      // event (Chrome 114+, Safari 18+, Firefox 109+); fall back to a timer
      // for older browsers.
      if (scrollSettleTimer !== null) window.clearTimeout(scrollSettleTimer);
      scrollSettleTimer = window.setTimeout(() => {
        programmaticScrollActive = false;
        scrollSettleTimer = null;
      }, 700);
    }

    track.addEventListener("scrollend", () => {
      programmaticScrollActive = false;
      if (scrollSettleTimer !== null) {
        window.clearTimeout(scrollSettleTimer);
        scrollSettleTimer = null;
      }
    });

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => goTo(Number(tab.dataset.mediaTab)));
    });

    // Sync tabs to whichever slide the user lands on via swipe/scroll —
    // but stay quiet while we're animating to a clicked destination.
    const observer = new IntersectionObserver(
      (entries) => {
        if (programmaticScrollActive) return;
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            syncTabs(Number((entry.target as HTMLElement).dataset.mediaSlide));
          }
        });
      },
      { root: track, threshold: 0.6 },
    );

    track.querySelectorAll("[data-media-slide]").forEach((slide) => observer.observe(slide));

    // Safari (esp. iOS / Low Power Mode) often ignores the `autoplay` attribute even when
    // `muted` + `playsinline` are set, and pauses off-screen <video>s to save power. Calling
    // play() each time a video scrolls into the track viewport recovers both cases without
    // restructuring the markup.
    const videoPlayObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const video = entry.target as HTMLVideoElement;
          void video.play().catch(() => {
            /* Autoplay was blocked (e.g. battery saver with no user gesture) — leave paused. */
          });
        });
      },
      { root: track, threshold: 0.25 },
    );

    shelf.querySelectorAll<HTMLVideoElement>("video").forEach((video) => videoPlayObserver.observe(video));
  });
</script>
