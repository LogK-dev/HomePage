---
interface Segment {
  label: string;
  src: string;
  type: "image" | "video";
}

interface Props {
  segments: Segment[];
}

const { segments } = Astro.props;
---

<div class="media-shelf" data-media-shelf>
  <!-- Segmented tab bar -->
  <div class="media-tabs-wrap">
    <div class="media-tabs" role="tablist" data-media-tabs>
      {segments.map((seg, i) => (
        <button
          type="button"
          role="tab"
          class:list={["media-tab", { "is-active": i === 0 }]}
          data-media-tab={i}
          aria-selected={i === 0 ? "true" : "false"}
        >
          {seg.label}
        </button>
      ))}
    </div>
  </div>

  <!-- Content shelf — peek both sides via 85% slide width + center snap -->
  <div class="media-shelf-track" data-media-track>
    {segments.map((seg, i) => (
      <div class="media-shelf-slide" data-media-slide={i}>
        {seg.type === "video" ? (
          <video src={seg.src} autoplay muted loop playsinline preload="auto" />
        ) : (
          <img src={seg.src} alt={seg.label} loading={i === 0 ? "eager" : "lazy"} />
        )}
      </div>
    ))}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-media-shelf]").forEach((shelf) => {
    const track = shelf.querySelector<HTMLElement>("[data-media-track]")!;
    const tabs = shelf.querySelectorAll<HTMLButtonElement>("[data-media-tab]");

    /** While a tab click is animating the track to its destination, intermediate
        slides pass through the observer threshold and would briefly steal
        `.is-active`, causing the tab bar to "blink" through every tab between
        source and destination. We lock the destination tab and suppress
        observer-driven sync until the programmatic scroll settles. */
    let programmaticScrollActive = false;
    let scrollSettleTimer: number | null = null;

    function syncTabs(index: number) {
      tabs.forEach((tab, i) => {
        tab.classList.toggle("is-active", i === index);
        tab.setAttribute("aria-selected", i === index ? "true" : "false");
      });
    }

    function goTo(index: number) {
      const slide = track.querySelector<HTMLElement>(`[data-media-slide="${index}"]`);
      if (!slide) return;
      // Lock the destination tab *before* scrolling so intermediate slides
      // can't flip it back.
      syncTabs(index);
      programmaticScrollActive = true;
      slide.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" });

      // Release the lock once scrolling stops. Prefer the native scrollend
      // event (Chrome 114+, Safari 18+, Firefox 109+); fall back to a timer
      // for older browsers.
      if (scrollSettleTimer !== null) window.clearTimeout(scrollSettleTimer);
      scrollSettleTimer = window.setTimeout(() => {
        programmaticScrollActive = false;
        scrollSettleTimer = null;
      }, 700);
    }

    track.addEventListener("scrollend", () => {
      programmaticScrollActive = false;
      if (scrollSettleTimer !== null) {
        window.clearTimeout(scrollSettleTimer);
        scrollSettleTimer = null;
      }
    });

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => goTo(Number(tab.dataset.mediaTab)));
    });

    /** Mouse-drag scrolling. Touch already pans natively; this just adds the
     *  same affordance for desktop mouse users. We don't intercept touch
     *  pointer events to avoid fighting the browser's native momentum scroll. */
    const DRAG_THRESHOLD_PX = 6;
    let dragState: {
      pointerId: number;
      startX: number;
      scrollStart: number;
      moved: boolean;
    } | null = null;
    /** When set to a future timestamp, slide-click handlers no-op until then.
     *  Prevents the click that fires at the end of a drag from re-centering
     *  whatever slide the cursor happened to release over. */
    let dragSuppressClicksUntil = 0;

    track.addEventListener("pointerdown", (event) => {
      if (event.pointerType !== "mouse" || event.button !== 0) return;
      dragState = {
        pointerId: event.pointerId,
        startX: event.clientX,
        scrollStart: track.scrollLeft,
        moved: false
      };
    });

    track.addEventListener("pointermove", (event) => {
      if (!dragState || event.pointerId !== dragState.pointerId) return;
      const delta = event.clientX - dragState.startX;
      if (!dragState.moved && Math.abs(delta) > DRAG_THRESHOLD_PX) {
        dragState.moved = true;
        track.classList.add("is-dragging");
        // Capture so the drag continues even if the cursor leaves the track.
        try { track.setPointerCapture(event.pointerId); } catch { /* noop */ }
      }
      if (dragState.moved) {
        // The track has `scroll-snap-type: x mandatory` which fights live
        // scrollLeft changes. `.is-dragging` disables snap in CSS during drag.
        track.scrollLeft = dragState.scrollStart - delta;
        event.preventDefault();
      }
    });

    function endDrag(event: PointerEvent) {
      if (!dragState || event.pointerId !== dragState.pointerId) return;
      const wasDrag = dragState.moved;
      dragState = null;
      if (wasDrag) {
        track.classList.remove("is-dragging");
        dragSuppressClicksUntil = performance.now() + 250;
        // Snap to the slide nearest the release position via the existing
        // goTo() — same animation + tab-sync path used by tab clicks.
        goTo(activeIndexAtCurrentScroll());
      }
    }
    track.addEventListener("pointerup", endDrag);
    track.addEventListener("pointercancel", endDrag);

    // Clicking a peeking slide on either side centers it — same path as a
    // tab click. Skip when the click is the tail-end of a drag.
    track.querySelectorAll<HTMLElement>("[data-media-slide]").forEach((slide) => {
      slide.addEventListener("click", () => {
        if (performance.now() < dragSuppressClicksUntil) return;
        goTo(Number(slide.dataset.mediaSlide));
      });
    });

    /** Track-scroll → active-tab sync.
     *
     *  The previous implementation used an IntersectionObserver with
     *  `threshold: 0.6`: a slide only counted as "active" once 60% of its
     *  area entered the viewport. During a fast horizontal flick across
     *  multiple slides, intermediate slides could fail to cross that
     *  threshold before scroll-snap captured the next destination — leaving
     *  the tab bar to jump from e.g. "멀티 위임" straight to "개인정보 보호"
     *  with no stop on "이미지 생성" in between.
     *
     *  This version computes which slide's *center* is nearest the track
     *  viewport's center on every scroll frame. Always-correct, no
     *  thresholds, naturally handles every scroll speed. */
    const slides = [...track.querySelectorAll<HTMLElement>("[data-media-slide]")];
    let scrollSyncFrame = 0;

    function activeIndexAtCurrentScroll(): number {
      const viewportCenter = track.scrollLeft + track.clientWidth / 2;
      let closest = 0;
      let closestDist = Infinity;
      for (let i = 0; i < slides.length; i++) {
        const slide = slides[i];
        const slideCenter = slide.offsetLeft + slide.clientWidth / 2;
        const dist = Math.abs(slideCenter - viewportCenter);
        if (dist < closestDist) {
          closestDist = dist;
          closest = i;
        }
      }
      return closest;
    }

    function onTrackScroll() {
      if (programmaticScrollActive) return;
      if (scrollSyncFrame) return;
      scrollSyncFrame = window.requestAnimationFrame(() => {
        scrollSyncFrame = 0;
        syncTabs(activeIndexAtCurrentScroll());
      });
    }

    track.addEventListener("scroll", onTrackScroll, { passive: true });

    /** Media (especially .mov videos) load asynchronously after first paint,
     *  which changes the slide widths and shifts the closest-to-center
     *  answer. A ResizeObserver re-runs the sync whenever the track or any
     *  slide resizes — covering the load race, font swaps, viewport rotates,
     *  and any future layout shift in one mechanism. */
    const resizeSync = new ResizeObserver(() => {
      if (programmaticScrollActive) return;
      syncTabs(activeIndexAtCurrentScroll());
    });
    resizeSync.observe(track);
    slides.forEach((slide) => resizeSync.observe(slide));

    // Safari (esp. iOS / Low Power Mode) often ignores the `autoplay` attribute even when
    // `muted` + `playsinline` are set, and pauses off-screen <video>s to save power. Calling
    // play() each time a video scrolls into the track viewport recovers both cases without
    // restructuring the markup.
    const videoPlayObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const video = entry.target as HTMLVideoElement;
          void video.play().catch(() => {
            /* Autoplay was blocked (e.g. battery saver with no user gesture) — leave paused. */
          });
        });
      },
      { root: track, threshold: 0.25 },
    );

    shelf.querySelectorAll<HTMLVideoElement>("video").forEach((video) => videoPlayObserver.observe(video));
  });
</script>
