---
import ContactBanner from "@/components/ContactBanner.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import MediaShelf from "@/components/MediaShelf.astro";
import type { Locale, SiteDictionary } from "@/i18n/schema";
import { getContactHref, getLanguageOptions, localizedPath } from "@/utils/i18n";

interface Props {
  locale: Locale;
  dictionary: SiteDictionary;
}

const { locale, dictionary } = Astro.props;
const pricingPath = localizedPath(locale, "pricing");
const languageOptions = getLanguageOptions(locale);
const base = import.meta.env.BASE_URL;
const mockupBase = `${base}assets/selecAI_mockup/`;

// Tab labels + asset filenames live in the dictionary so they share the
// i18n surface with the rest of user-facing copy. The component just
// resolves the asset filenames to fully-qualified URLs here.
const mediaSegments = dictionary.mediaShelf.map((entry) => ({
  label: entry.label,
  src: `${mockupBase}${entry.asset}`,
  type: entry.type
}));
---

<Header locale={locale} dictionary={dictionary} languageOptions={languageOptions} />

<main id="top">

  <!-- ── Hero ──────────────────────────────────────────────────────────── -->
  <section class="hero section">
    <div class="hero-copy" data-reveal>
      <p class="eyebrow">{dictionary.hero.eyebrow}</p>
      <h1>
        {/* Title contains `\n` separators in the dictionary; split into one
            <span> per line so the CSS can pin each as a block + nowrap and
            the layout never collapses or wraps further regardless of width. */}
        {dictionary.hero.title.split("\n").map((line) => (
          <span class="hero-title-line">{line}</span>
        ))}
        <span class="headline-shift">{dictionary.hero.titleAccent}</span>
      </h1>
      <p class="hero-lede">{dictionary.hero.lede}</p>

      <div class="hero-actions">
        <a class="button" href="#service">{dictionary.hero.primaryCta}</a>
        <a class="button button-ghost" href={pricingPath}>{dictionary.hero.secondaryCta}</a>
      </div>
    </div>

    <div class="hero-visual" data-reveal aria-hidden="true">
      <video
        src={`${mockupBase}selecAI_multi_delegate.mov`}
        autoplay
        muted
        loop
        playsinline
      ></video>
    </div>
  </section>

  <!-- ── Service overview ──────────────────────────────────────────────── -->
  <section id="service" class="section home-service-section">
    <div class="section-head narrow" data-reveal>
      <h2 class="service-title">{dictionary.productPage.title}</h2>
    </div>

  </section>

  <!-- ── Media shelf ───────────────────────────────────────────────────── -->
  <section class="section media-shelf-section">
    <div class="media-shelf-intro" data-reveal>
      <p class="section-lede">{dictionary.productPage.description}</p>
      <p class="section-lede">{dictionary.mediaShelfLede}</p>
    </div>
    <MediaShelf segments={mediaSegments} />
  </section>

  <!-- ── Customers ────────────────────────────────────────────────────── -->
  <section class="section customer-logos-section" data-reveal>
    <p class="eyebrow">{dictionary.customersEyebrow}</p>
    <ul class="customer-logos">
      {dictionary.customers.map((customer) => (
        <li>
          <a
            class="customer-logo"
            href={customer.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={customer.name}
          >
            <img src={`${base}assets/customer_logo_list/${customer.asset}`} alt={customer.name} loading="lazy" />
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- ── Company ──────────────────────────────────────────────────────── -->
  <section id="company" class="section company-about-section" data-reveal>
    <p class="eyebrow">{dictionary.company.eyebrow}</p>
    <div class="company-about-body">
      {dictionary.company.body.map((para) => <p>{para}</p>)}
    </div>
  </section>

  <!-- ── CTA ───────────────────────────────────────────────────────────── -->
  <section class="section contact-section" data-reveal>
    <ContactBanner
      eyebrow={dictionary.productPage.nextEyebrow}
      title={dictionary.productPage.nextTitle}
      body={dictionary.productPage.nextBody}
      primaryLabel={dictionary.productPage.primaryCta}
      primaryHref={getContactHref(dictionary)}
      secondaryLabel={dictionary.pricingPage.eyebrow}
      secondaryHref={pricingPath}
    />
  </section>

</main>

<Footer />
