---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import type { Locale, SiteDictionary } from "@/i18n/schema";
import { getLanguageOptions, localizedPath } from "@/utils/i18n";

interface Props {
  locale: Locale;
  dictionary: SiteDictionary;
}

const { locale, dictionary } = Astro.props;
const servicePath = `${localizedPath(locale)}#service`;
const pricingPath = localizedPath(locale, "pricing");
const languageOptions = getLanguageOptions(locale);
const productPreviewBase = `${import.meta.env.BASE_URL}product-preview/`;
const previewFeatures = dictionary.hero.previewFeatures;
const previewJsSrc = `${productPreviewBase}product-preview.js${import.meta.env.PROD ? `?v=${Date.now()}` : ""}`;
const gallery = dictionary.productPage.gallery;
---

<Header locale={locale} dictionary={dictionary} languageOptions={languageOptions} />

<main id="top">
  <section class="hero section">
    <div class="hero-copy" data-reveal>
      <p class="eyebrow">{dictionary.hero.eyebrow}</p>
      <h1>
        {dictionary.hero.title}
        <span class="headline-shift">{dictionary.hero.titleAccent}</span>
      </h1>
      <p class="hero-lede">{dictionary.hero.lede}</p>

      <div class="hero-actions">
        <a class="button" href="#service">{dictionary.hero.primaryCta}</a>
        <a class="button button-ghost" href={pricingPath}>{dictionary.hero.secondaryCta}</a>
      </div>

      <ul class="hero-metrics" aria-label="Key outcomes">
        {dictionary.hero.metrics.map((metric) => (
          <li>
            <strong>{metric.value}</strong>
            <span>{metric.label}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="hero-preview" data-preview-area data-reveal>
      <div class="preview-switcher" data-preview-switcher aria-label="Product feature tabs">
        {previewFeatures.map((feature, index) => (
          <button
            class:list={["preview-switcher-button", { "is-active": index === 0 }]}
            type="button"
            data-preview-feature={feature.id}
            aria-selected={index === 0 ? "true" : "false"}
          >
            <strong>{feature.label}</strong>
          </button>
        ))}
      </div>

      <div class="preview-feature-copy" data-preview-feature-copy>
        {previewFeatures.map((feature, index) => (
          <article class:list={["preview-feature-panel", { "is-active": index === 0 }]} data-preview-feature-panel={feature.id}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{feature.label}</strong>
            <p>{feature.summary}</p>
          </article>
        ))}
      </div>

      <div class="product-preview-mount">
        <div data-product-preview data-locale={locale} data-feature={previewFeatures[0].id} data-product-url={servicePath}>
          <div class="product-preview-fallback">
            <strong>{dictionary.hero.previewFallback.title}</strong>
            <p>{dictionary.hero.previewFallback.body}</p>
          </div>
        </div>
      </div>
      <script is:inline type="module" src={previewJsSrc}></script>
      <script is:inline>
        const initPreviewSwitchers = () => {
          document.querySelectorAll("[data-preview-switcher]").forEach((switcher) => {
            if (switcher.dataset.previewSwitcherBound === "true") {
              return;
            }

            switcher.dataset.previewSwitcherBound = "true";
            const previewArea = switcher.closest("[data-preview-area]") ?? document;
            const buttons = Array.from(switcher.querySelectorAll("[data-preview-feature]"));
            const panels = Array.from(previewArea.querySelectorAll("[data-preview-feature-panel]"));

            buttons.forEach((button) => {
              button.addEventListener("click", () => {
                const feature = button.dataset.previewFeature;

                buttons.forEach((item) => {
                  const isActive = item === button;
                  item.classList.toggle("is-active", isActive);
                  item.setAttribute("aria-selected", String(isActive));
                });

                panels.forEach((panel) => {
                  panel.classList.toggle("is-active", panel.dataset.previewFeaturePanel === feature);
                });

                window.dispatchEvent(
                  new CustomEvent("logk-preview:set-feature", {
                    detail: { feature }
                  })
                );
              });
            });
          });
        };

        initPreviewSwitchers();
        document.addEventListener("astro:page-load", initPreviewSwitchers);
      </script>
    </div>
  </section>

  <section class="trust-strip section">
    <div class="trust-row">
      {dictionary.trust.map((item) => (
        <span>{item}</span>
      ))}
    </div>
  </section>

  <section id="service" class="product-hero section home-service-section">
    <div class="section-head narrow" data-reveal>
      <p class="eyebrow">{dictionary.productPage.eyebrow}</p>
      <h2>{dictionary.productPage.title}</h2>
      <p>{dictionary.productPage.description}</p>
    </div>

    <div class="product-stage" data-reveal>
      <img class="stage-art" src={`${import.meta.env.BASE_URL}assets/tech-lattice.svg`} alt="" aria-hidden="true" />
      <div class="stage-shell">
        {dictionary.productPage.stages.map((stage) => (
          <div class="stage-column">
            <span class="stage-label">{stage.label}</span>
            <strong>{stage.title}</strong>
            <p>{stage.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section product-gallery">
    <article class="product-screenshot-card" data-reveal>
      <div class="product-screenshot-copy">
        <span class="card-index">{gallery.workspaceLabel}</span>
        <h2>{gallery.workspaceTitle}</h2>
        <p>{gallery.workspaceBody}</p>
      </div>
      <img
        class="product-screenshot-image"
        src={`${import.meta.env.BASE_URL}assets/workspace_screenshot.png`}
        alt={gallery.workspaceAlt}
      />
    </article>

    <article class="product-screenshot-card" data-reveal>
      <div class="product-screenshot-copy">
        <span class="card-index">{gallery.pricingLabel}</span>
        <h2>{gallery.pricingTitle}</h2>
        <p>{gallery.pricingBody}</p>
      </div>
      <img
        class="product-screenshot-image"
        src={`${import.meta.env.BASE_URL}assets/pricing_screenshot.png`}
        alt={gallery.pricingAlt}
      />
    </article>
  </section>

  <section class="section product-grid">
    {dictionary.productPage.surfaces.map((surface) => (
      <article class:list={["product-card", { "product-card-wide": surface.wide }]} data-reveal>
        <span class="card-index">{surface.index}</span>
        <h2>{surface.title}</h2>
        <p>{surface.body}</p>
      </article>
    ))}
  </section>

  <section class="section timeline-section">
    <div class="section-head narrow" data-reveal>
      <p class="eyebrow">{dictionary.productPage.flowEyebrow}</p>
      <h2>{dictionary.productPage.flowTitle}</h2>
      <p>{dictionary.productPage.flowDescription}</p>
    </div>

    <div class="timeline-card" data-reveal>
      {dictionary.productPage.steps.map((step) => (
        <div class="timeline-step">
          <span>{step.number}</span>
          <div>
            <strong>{step.title}</strong>
            <p>{step.body}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section contact-section" data-reveal>
    <div class="contact-card">
      <div class="contact-copy">
        <p class="eyebrow">{dictionary.productPage.nextEyebrow}</p>
        <h2>{dictionary.productPage.nextTitle}</h2>
        <p>{dictionary.productPage.nextBody}</p>
      </div>

      <div class="contact-actions">
        <a class="button" href="mailto:contact@logk.co.kr">{dictionary.productPage.primaryCta}</a>
        <a class="button button-ghost" href={pricingPath}>{dictionary.pricingPage.eyebrow}</a>
      </div>
    </div>
  </section>
</main>

<Footer locale={locale} dictionary={dictionary} />
