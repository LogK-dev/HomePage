---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import type { Locale, SiteDictionary } from "@/i18n/schema";
import { getLanguageOptions, localizedPath } from "@/utils/i18n";

interface Props {
  locale: Locale;
  dictionary: SiteDictionary;
}

const { locale, dictionary } = Astro.props;
const servicePath = `${localizedPath(locale)}#service`;
const pricingPath = localizedPath(locale, "pricing");
const languageOptions = getLanguageOptions(locale);
const base = import.meta.env.BASE_URL;
const mockupBase = `${base}assets/selecAI_mockup/`;
const productPreviewBase = `${base}product-preview/`;
const previewFeatures = dictionary.hero.previewFeatures;
const previewJsSrc = `${productPreviewBase}product-preview.js${import.meta.env.PROD ? `?v=${Date.now()}` : ""}`;
const f = dictionary.features;

/* asset paths paired with feature rows */
const rowAssets = [
  { src: `${mockupBase}selecAI_private_masking.png`, type: "image" as const, reverse: false },
  { src: `${mockupBase}selecAI_prompt_pay.png`,      type: "image" as const, reverse: true  },
  { src: `${mockupBase}selecAI_image_gen.mov`,       type: "video" as const, reverse: false },
];
---

<Header locale={locale} dictionary={dictionary} languageOptions={languageOptions} />

<main id="top">

  <!-- ── Hero ──────────────────────────────────────────────────────────── -->
  <section class="hero section">
    <div class="hero-copy" data-reveal>
      <p class="eyebrow">{dictionary.hero.eyebrow}</p>
      <h1>
        {dictionary.hero.title}
        <span class="headline-shift">{dictionary.hero.titleAccent}</span>
      </h1>
      <p class="hero-lede">{dictionary.hero.lede}</p>

      <div class="hero-actions">
        <a class="button" href="#service">{dictionary.hero.primaryCta}</a>
        <a class="button button-ghost" href={pricingPath}>{dictionary.hero.secondaryCta}</a>
      </div>

      <ul class="hero-metrics" aria-label="Key outcomes">
        {dictionary.hero.metrics.map((metric) => (
          <li>
            <strong>{metric.value}</strong>
            <span>{metric.label}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Hero visual: multi-delegate screen recording -->
    <div class="hero-visual" data-reveal>
      <video
        src={`${mockupBase}selecAI_multi_delegate.mov`}
        autoplay
        muted
        loop
        playsinline
        aria-label="여러 AI 채팅 이력을 한 화면에서 확인하는 데모"
      ></video>
    </div>

    <!-- Product preview — code preserved, visually disabled -->
    <div class="hero-preview" aria-hidden="true" style="display:none" data-preview-area>
      <div class="preview-switcher" data-preview-switcher aria-label="Product feature tabs">
        {previewFeatures.map((feature, index) => (
          <button
            class:list={["preview-switcher-button", { "is-active": index === 0 }]}
            type="button"
            data-preview-feature={feature.id}
            aria-selected={index === 0 ? "true" : "false"}
          >
            <strong>{feature.label}</strong>
          </button>
        ))}
      </div>
      <div class="preview-feature-copy" data-preview-feature-copy>
        {previewFeatures.map((feature, index) => (
          <article class:list={["preview-feature-panel", { "is-active": index === 0 }]} data-preview-feature-panel={feature.id}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{feature.label}</strong>
            <p>{feature.summary}</p>
          </article>
        ))}
      </div>
      <div class="product-preview-mount">
        <div data-product-preview data-locale={locale} data-feature={previewFeatures[0].id} data-product-url={servicePath}>
          <div class="product-preview-fallback">
            <strong>{dictionary.hero.previewFallback.title}</strong>
            <p>{dictionary.hero.previewFallback.body}</p>
          </div>
        </div>
      </div>
      <script is:inline type="module" src={previewJsSrc}></script>
    </div>
  </section>

  <!-- ── Trust strip ───────────────────────────────────────────────────── -->
  <section class="trust-strip section">
    <div class="trust-row">
      {dictionary.trust.map((item) => (
        <span>{item}</span>
      ))}
    </div>
  </section>

  <!-- ── Service overview ──────────────────────────────────────────────── -->
  <section id="service" class="section home-service-section">
    <div class="section-head narrow" data-reveal>
      <p class="eyebrow">{dictionary.productPage.eyebrow}</p>
      <h2>{dictionary.productPage.title}</h2>
      <p>{dictionary.productPage.description}</p>
    </div>

    <div class="stage-shell" data-reveal>
      {dictionary.productPage.stages.map((stage) => (
        <div class="stage-column">
          <span class="stage-label">{stage.label}</span>
          <strong>{stage.title}</strong>
          <p>{stage.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ── Feature rows ──────────────────────────────────────────────────── -->
  <section class="section features-section">
    <div class="section-head narrow" data-reveal>
      <p class="eyebrow">{f.eyebrow}</p>
      <h2>{f.title}</h2>
      <p>{f.description}</p>
    </div>

    {f.rows.map((row, i) => {
      const asset = rowAssets[i];
      return (
        <div class:list={["feature-row", { "feature-row-flip": asset.reverse }]} data-reveal>
          <div class="feature-row-copy">
            <p class="eyebrow">{row.eyebrow}</p>
            <h3>{row.title}</h3>
            <p>{row.body}</p>
            {row.bullets && (
              <ul class="feature-bullets">
                {row.bullets.map((b) => <li>{b}</li>)}
              </ul>
            )}
          </div>
          <div class="feature-row-visual">
            {asset.type === "video" ? (
              <video src={asset.src} autoplay muted loop playsinline></video>
            ) : (
              <img src={asset.src} alt={row.title} loading="lazy" />
            )}
          </div>
        </div>
      );
    })}
  </section>

  <!-- ── Admin pair section ─────────────────────────────────────────────── -->
  <section class="section admin-section" data-reveal>
    <div class="admin-copy">
      <p class="eyebrow">{f.adminSection.eyebrow}</p>
      <h2>{f.adminSection.title}</h2>
      <p>{f.adminSection.description}</p>
    </div>
    <div class="admin-pair">
      <figure class="admin-card">
        <img src={`${mockupBase}selecAI_corp_mgnt.png`} alt={f.adminSection.corp.alt} loading="lazy" />
        <figcaption>
          <strong>{f.adminSection.corp.title}</strong>
          <span>{f.adminSection.corp.body}</span>
        </figcaption>
      </figure>
      <figure class="admin-card">
        <img src={`${mockupBase}selecAI_user_mgmt.png`} alt={f.adminSection.user.alt} loading="lazy" />
        <figcaption>
          <strong>{f.adminSection.user.title}</strong>
          <span>{f.adminSection.user.body}</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ── CTA ───────────────────────────────────────────────────────────── -->
  <section class="section contact-section" data-reveal>
    <div class="contact-card">
      <div class="contact-copy">
        <p class="eyebrow">{dictionary.productPage.nextEyebrow}</p>
        <h2>{dictionary.productPage.nextTitle}</h2>
        <p>{dictionary.productPage.nextBody}</p>
      </div>
      <div class="contact-actions">
        <a class="button" href="mailto:contact@logk.co.kr">{dictionary.productPage.primaryCta}</a>
        <a class="button button-ghost" href={pricingPath}>{dictionary.pricingPage.eyebrow}</a>
      </div>
    </div>
  </section>

</main>

<Footer locale={locale} dictionary={dictionary} />
