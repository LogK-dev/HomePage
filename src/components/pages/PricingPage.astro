---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import type { Locale, SiteDictionary } from "@/i18n/schema";
import { getLanguageOptions, localizedPath } from "@/utils/i18n";
import { preferBreakAt } from "@/utils/text";

interface Props {
  locale: Locale;
  dictionary: SiteDictionary;
}

const { locale, dictionary } = Astro.props;
const p = dictionary.pricingPage;
const homePath = localizedPath(locale);
---

<Header locale={locale} dictionary={dictionary} languageOptions={getLanguageOptions(locale, "pricing")} />

<main>

  <!-- ── Hero ─────────────────────────────────────────────────────────────── -->
  <section class="pricing-hero">
    <div class="pricing-hero-inner">
      <div class="pricing-badge-pill">
        <span class="pricing-badge-dot"></span>
        {p.badge}
      </div>
      <h1 class="pricing-h1">
        {p.title}
        {p.titleEmphasis && <><br /><em class="pricing-h1-em">{p.titleEmphasis}</em></>}
      </h1>
      <p class="pricing-lede">{p.description}</p>

      <div class="pricing-toggle-wrap" data-pricing-toggle>
        <button class="ptoggle-btn is-active" data-mode="monthly">{p.toggle.monthly}</button>
        <button class="ptoggle-btn" data-mode="yearly">
          {p.toggle.yearly}
          <span class="ptoggle-discount">{p.toggle.discount}</span>
        </button>
      </div>
      <p class="pricing-annual-hint">{p.toggle.annualNote}</p>
    </div>
  </section>

  <!-- ── Plan cards ────────────────────────────────────────────────────────── -->
  <section class="section pricing-plans-section" data-pricing-mode="monthly">
    <div class="pricing-grid">
      {p.plans.map((plan) => (
        <article class:list={["plan-card", { "plan-card-popular": plan.highlight }]}>
          {plan.badge && <span class="plan-popular-badge">{plan.badge}</span>}

          <div class="plan-head">
            <div class="plan-name">{plan.name}</div>
            <div class="plan-tagline">{plan.tagline}</div>
            <div class="plan-price-row">
              <!-- "Was" line: monthly price with strikethrough, animated in when yearly mode is active. -->
              <div class="plan-price-was" aria-hidden="true">
                <span class="plan-currency-was">{plan.currency}</span>
                <span class="plan-amount-was">{plan.monthlyPrice}</span>
                <span class="plan-period-was">/월</span>
              </div>
              <div class="plan-price-now">
                <span class="plan-currency">{plan.currency}</span>
                <span class="plan-amount" data-monthly={plan.monthlyPrice} data-yearly={plan.yearlyPrice}>
                  {plan.monthlyPrice}
                </span>
                <span class="plan-period">/월</span>
              </div>
            </div>
            <div class="plan-annual-note" data-annual-price={`연 ${plan.currency}${
              (parseInt(plan.yearlyPrice.replace(/,/g, "")) * 12).toLocaleString("ko-KR")
            } 청구`}></div>
          </div>

          <div class="plan-credit-box">
            <div class="plan-credit-label">{p.creditLabel}</div>
            <div class="plan-credit-amount">
              <span class="plan-credits">{plan.credits}</span>
              <span class="plan-credits-unit"> 크레딧</span>
            </div>
            {plan.bonusCredits && (
              <span class="plan-bonus">🎁 보너스 {plan.bonusCredits} 크레딧 포함</span>
            )}
          </div>

          <a
            class:list={["button", "plan-cta", { "plan-cta-popular": plan.highlight, "plan-cta-default": !plan.highlight }]}
            href={plan.ctaHref}
          >
            {plan.ctaLabel}
          </a>

          <hr class="plan-divider" />
          <div class="plan-features-label">포함 기능</div>
          <ul class="plan-features">
            {plan.features.map((f) => (
              <li class="plan-feature-item">
                <span class:list={["plan-feat-icon", f.icon === "shield" ? "icon-shield" : "icon-check"]}>
                  {f.icon === "shield" ? "🛡" : "✓"}
                </span>
                <span>
                  {f.text}
                  {f.sub && <small class="plan-feat-sub">{f.sub}</small>}
                </span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <!-- Enterprise band -->
    <div class="enterprise-band" data-reveal>
      <div class="enterprise-left">
        <h3>{p.enterprise.title}</h3>
        <p>
          공공기관, 금융, 의료, 대기업 등 고보안 환경에 최적화된<br class="br-narrow" />
          폐쇄망 구축형 서비스입니다.<br />
          원화 결제 및 조직 맞춤형 보안 설정을 지원합니다.
        </p>
        <div class="enterprise-tags">
          {p.enterprise.tags.map((tag) => (
            <span class="enterprise-tag">{tag}</span>
          ))}
        </div>
      </div>
      <div class="enterprise-right">
        <a class="button enterprise-cta" href={p.enterprise.ctaHref}>{p.enterprise.ctaLabel}</a>
        <span class="enterprise-note">{p.enterprise.note}</span>
      </div>
    </div>
  </section>

  <!-- ── Credit notes ──────────────────────────────────────────────────────── -->
  <div class="pricing-container">
    <div class="credit-notes" data-reveal>
      {p.creditNotes.map((note) => (
        <p>※ {note}</p>
      ))}
    </div>
  </div>

  <!-- ── FAQ ──────────────────────────────────────────────────────────────── -->
  <section class="section faq-section">
    <div class="pricing-container">
      <div class="section-head narrow" data-reveal>
        <h2>{p.faq.title}</h2>
      </div>
      <div class="faq-list">
        {p.faq.items.map((item) => (
          <div class="faq-item" data-faq>
            <button class="faq-question" type="button">
              {item.question}
              <span class="faq-arrow" aria-hidden="true">▼</span>
            </button>
            <div class="faq-answer">
              <div class="faq-answer-inner">{item.answer}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Trial banner ──────────────────────────────────────────────────────── -->
  <div class="pricing-container" style="padding-bottom: 5rem;">
    <div class="trial-banner" data-reveal>
      <h2>{p.trialBanner.title}</h2>
      <p>{preferBreakAt(p.trialBanner.body)}</p>
      <a class="button trial-cta" href={p.trialBanner.ctaHref}>{p.trialBanner.ctaLabel}</a>
    </div>
  </div>

</main>

<Footer locale={locale} dictionary={dictionary} />

<script>
  /* ── Monthly / Yearly toggle ─────────────────────────────────────────────── */
  const toggle = document.querySelector("[data-pricing-toggle]");
  if (toggle) {
    const buttons = [...toggle.querySelectorAll<HTMLButtonElement>(".ptoggle-btn")];

    // The plans section drives the "was → now" animation off its `data-pricing-mode` attribute.
    const plansSection = document.querySelector<HTMLElement>("[data-pricing-mode]");

    const setMode = (mode: string) => {
      buttons.forEach(b => b.classList.toggle("is-active", b.dataset.mode === mode));
      const isYearly = mode === "yearly";

      if (plansSection) plansSection.setAttribute("data-pricing-mode", mode);

      document.querySelectorAll<HTMLElement>(".plan-amount").forEach(el => {
        el.textContent = isYearly ? (el.dataset.yearly ?? "") : (el.dataset.monthly ?? "");
      });

      document.querySelectorAll<HTMLElement>(".plan-annual-note").forEach(el => {
        el.textContent = isYearly ? (el.dataset.annualPrice ?? "") : "";
      });
    };

    buttons.forEach(btn => {
      btn.addEventListener("click", () => setMode(btn.dataset.mode ?? "monthly"));
    });
  }

  /* ── FAQ accordion ───────────────────────────────────────────────────────── */
  document.querySelectorAll<HTMLElement>("[data-faq]").forEach(item => {
    const btn = item.querySelector<HTMLButtonElement>(".faq-question");
    const answer = item.querySelector<HTMLElement>(".faq-answer");
    if (!btn || !answer) return;

    btn.addEventListener("click", () => {
      const isOpen = item.classList.contains("is-open");
      // Close all
      document.querySelectorAll("[data-faq]").forEach(el => {
        el.classList.remove("is-open");
        el.querySelector(".faq-answer")?.classList.remove("is-open");
      });
      // Toggle clicked
      if (!isOpen) {
        item.classList.add("is-open");
        answer.classList.add("is-open");
      }
    });
  });
</script>
