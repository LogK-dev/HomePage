<script>
  let revealObserver: IntersectionObserver | undefined;

  const syncHeaderState = () => {
    const header = document.querySelector<HTMLElement>("[data-header]");
    if (!header) {
      return;
    }

    header.classList.toggle("is-condensed", window.scrollY > 18);
  };

  const initReveal = (reducedMotion: boolean) => {
    if (revealObserver) {
      revealObserver.disconnect();
      revealObserver = undefined;
    }

    const revealItems = [...document.querySelectorAll<HTMLElement>("[data-reveal]")];
    if (revealItems.length === 0) {
      return;
    }

    revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            revealObserver!.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.16,
        rootMargin: "0px 0px -48px 0px"
      }
    );

    revealItems.forEach((item, index) => {
      item.style.transitionDelay = reducedMotion ? "0ms" : `${Math.min(index * 40, 220)}ms`;
      revealObserver!.observe(item);
    });
  };

  const initMobileMenu = () => {
    const header = document.querySelector<HTMLElement>("[data-header]");
    const navToggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
    const nav = document.querySelector<HTMLElement>("[data-nav]");

    if (!header || !navToggle || !nav) {
      return;
    }

    if (navToggle.dataset.menuInitialized === "true") {
      return;
    }

    navToggle.dataset.menuInitialized = "true";

    /** Close the mobile menu and reset toggle ARIA attributes. */
    const closeMenu = () => {
      const openLabel = navToggle.dataset.menuOpenLabel ?? "Open menu";
      navToggle.setAttribute("aria-expanded", "false");
      navToggle.setAttribute("aria-label", openLabel);
      header.classList.remove("menu-open");
      document.body.classList.remove("menu-open");
    };

    navToggle.addEventListener("click", () => {
      const expanded = navToggle.getAttribute("aria-expanded") === "true";
      const openLabel = navToggle.dataset.menuOpenLabel ?? "Open menu";
      const closeLabel = navToggle.dataset.menuCloseLabel ?? "Close menu";
      navToggle.setAttribute("aria-expanded", String(!expanded));
      navToggle.setAttribute("aria-label", expanded ? openLabel : closeLabel);
      header.classList.toggle("menu-open", !expanded);
      document.body.classList.toggle("menu-open", !expanded);

      // When transitioning into the open state, arm a one-shot scroll
      // listener that auto-dismisses the dropdown the moment the user
      // begins scrolling. Deferred by one frame so the click-induced
      // layout shift can't trip the listener immediately.
      if (!expanded) {
        window.requestAnimationFrame(() => {
          window.addEventListener(
            "scroll",
            () => {
              if (header.classList.contains("menu-open")) closeMenu();
            },
            { once: true, passive: true }
          );
        });
      }
    });

    [
      ...nav.querySelectorAll<HTMLAnchorElement>("a"),
      ...document.querySelectorAll<HTMLAnchorElement>(".header-actions a"),
      ...document.querySelectorAll<HTMLAnchorElement>(".header-controls a")
    ].forEach((link) => {
      link.addEventListener("click", closeMenu);
    });
  };

  const initPricingToggle = () => {
    document.querySelectorAll<HTMLElement>("[data-pricing-toggle]").forEach((toggle) => {
      const buttons = [...toggle.querySelectorAll<HTMLButtonElement>(".ptoggle-btn")];
      if (buttons.length === 0) {
        return;
      }

      // The plans section advertises a `data-pricing-mode` attribute that
      // CSS uses to drive the "was → now" strikethrough animation. Each
      // mode flip writes both the textContent swaps and the attribute.
      const plansSection = document.querySelector<HTMLElement>("[data-pricing-mode]");

      const setMode = (mode: string) => {
        buttons.forEach((button) => {
          const isActive = button.dataset.mode === mode;
          button.classList.toggle("is-active", isActive);
          button.setAttribute("aria-pressed", String(isActive));
        });

        const isYearly = mode === "yearly";
        plansSection?.setAttribute("data-pricing-mode", mode);

        document.querySelectorAll<HTMLElement>(".plan-amount").forEach((node) => {
          node.textContent = isYearly ? (node.dataset.yearly ?? "") : (node.dataset.monthly ?? "");
        });

        document.querySelectorAll<HTMLElement>(".plan-annual-note").forEach((node) => {
          node.textContent = isYearly ? (node.dataset.annualPrice ?? "") : "";
        });
      };

      const activeMode = buttons.find((button) => button.classList.contains("is-active"))?.dataset.mode ?? "monthly";
      setMode(activeMode);

      if (toggle.dataset.pricingToggleInitialized === "true") {
        return;
      }

      toggle.dataset.pricingToggleInitialized = "true";
      buttons.forEach((button) => {
        button.addEventListener("click", () => setMode(button.dataset.mode ?? "monthly"));
      });
    });
  };

  const initFaq = () => {
    document.querySelectorAll<HTMLElement>("[data-faq]").forEach((item) => {
      if (item.dataset.faqInitialized === "true") {
        return;
      }
      item.dataset.faqInitialized = "true";

      const trigger = item.querySelector<HTMLButtonElement>(".faq-question");
      const answer = item.querySelector<HTMLElement>(".faq-answer");
      if (!trigger || !answer) {
        return;
      }

      trigger.addEventListener("click", () => {
        const wasOpen = item.classList.contains("is-open");
        // Accordion behavior: close any sibling that's currently open.
        document.querySelectorAll<HTMLElement>("[data-faq].is-open").forEach((open) => {
          open.classList.remove("is-open");
          open.querySelector<HTMLElement>(".faq-answer")?.classList.remove("is-open");
        });
        if (!wasOpen) {
          item.classList.add("is-open");
          answer.classList.add("is-open");
        }
      });
    });
  };

  const initPage = () => {
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    initMobileMenu();
    initPricingToggle();
    initFaq();
    initReveal(reducedMotion);
    syncHeaderState();
    document.querySelectorAll<HTMLElement>("[data-year]").forEach((node) => {
      node.textContent = String(new Date().getFullYear());
    });
  };

  window.addEventListener(
    "scroll",
    () => {
      syncHeaderState();
    },
    { passive: true }
  );

  document.addEventListener("astro:page-load", initPage);
  initPage();
</script>
