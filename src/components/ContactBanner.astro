---
interface Props {
  eyebrow?: string;
  title: string;
  body: string;
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const { eyebrow, title, body, primaryLabel, primaryHref, secondaryLabel, secondaryHref } =
  Astro.props;
---

<div class="trial-banner">
  {eyebrow && <p class="trial-eyebrow">{eyebrow}</p>}
  <h2>{title}</h2>
  <p>{body}</p>
  <div class="trial-banner-actions">
    <a class="trial-cta button" href={primaryHref}>{primaryLabel}</a>
    {secondaryLabel && secondaryHref && (
      <a class="button trial-cta-secondary" href={secondaryHref}>{secondaryLabel}</a>
    )}
  </div>
</div>
