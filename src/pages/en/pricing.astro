---
import PricingPage from "@/components/pages/PricingPage.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getDictionary } from "@/i18n/messages";

const locale = "en";
const dictionary = getDictionary(locale);
---

<BaseLayout locale={locale} title={dictionary.meta.pricingTitle} description={dictionary.meta.pricingDescription}>
  <PricingPage locale={locale} dictionary={dictionary} />
</BaseLayout>
