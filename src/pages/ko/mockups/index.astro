---
import MockupsPage from "@/components/pages/MockupsPage.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getDictionary } from "@/i18n/messages";

const locale = "ko";
const dictionary = getDictionary(locale);
---

<BaseLayout
  locale={locale}
  title={dictionary.meta.mockupsTitle}
  description={dictionary.meta.mockupsDescription}
  ogImageFile="og-mockups.png"
>
  <MockupsPage locale={locale} dictionary={dictionary} />
</BaseLayout>
